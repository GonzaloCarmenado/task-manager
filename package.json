{
  "name": "task-manager",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/env-init.mjs && ng serve",
    "build": "node scripts/env-init.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/env-init.mjs && ng test",
    "test:ci": "node scripts/env-init.mjs && ng test --no-watch",
    "test:coverage": "node scripts/env-init.mjs && ng test --no-watch --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "type-check": "node scripts/env-init.mjs && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "prepare": "husky && node scripts/env-init.mjs",
    "tauri": "tauri",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "secrets:check": "node scripts/check-secrets.mjs",
    "env:init": "node scripts/env-init.mjs",
    "db:link": "supabase link",
    "db:push": "supabase db push --remote",
    "db:pull": "supabase db pull --remote",
    "db:new": "supabase migration new",
    "db:status": "supabase migration list --remote",
    "db:push:dry": "supabase db push --remote --dry-run",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@supabase/supabase-js": "^2.119.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1",
    "supabase": "^3.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,js,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.scss": [
      "prettier --write"
    ]
  }
}
